---
import { getImage } from 'astro:assets';
import enSrc from '../images/en.png';
import esSrc from '../images/es.png';
//import ingles from 'img/demos/resume/about-me/origin/en.png';
//import espanhol from 'img/demos/resume/about-me/origin/es.png';
const en = await getImage({ src: enSrc, width: 16, format: 'webp' });

const es = await getImage({ src: esSrc, width: 16, format: 'webp' });

---


<div class="col-md-6 col-lg-4">
    <div class="row">
        <div class="col">
            <div class="custom-box-details bg-color-darken custom-box-shadow-1">
                <h4 class="text-color-light">Idiomas</h4>
                <ul class="custom-list-style-1 p-0">
                    <li>
                        <span class="font-weight-semibold custom-max-width-1 text-color-light"><img src={en.src} class="flag flag-us me-1" alt="English" />Ingles:</span>
                        <span class="custom-text-color-2">Intermedio</span>
                    </li>
                    <li>
                        <span class="font-weight-semibold custom-max-width-1 text-color-light"><img src={es.src} class="flag flag-es me-1" alt="Spanish" />Español:</span>
                        <span class="custom-text-color-2">Avanzado</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>