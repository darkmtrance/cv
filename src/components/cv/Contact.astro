---
import Icon from './Icon.astro';
import ContactForm from './ContactForm.jsx';
import { ui } from '../../data/ui';
import { person } from '../../data/cv';
import type { Lang } from '../../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section class="section sheet" id="contact" aria-labelledby="contact-title">
  <h2 class="section-title" id="contact-title">{t.contact}</h2>
  <div class="split">
    <div>
      <p class="contact-intro">{t.contactIntro}</p>
      <ul class="channels">
        <li><a href={`mailto:${person.email}`}><Icon name="mail" />{person.email}</a></li>
        <li><a href={person.phoneHref}><Icon name="phone" />{person.phone}</a></li>
        <li><a href={person.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" />LinkedIn</a></li>
        <li><a href={person.github} target="_blank" rel="noopener"><Icon name="github" />GitHub</a></li>
        <li><a href={person.credly} target="_blank" rel="noopener"><Icon name="badge" />Credly</a></li>
        <li><a href={person.blog} target="_blank" rel="noopener"><Icon name="pen" />{person.blogLabel}</a></li>
      </ul>
    </div>
    <ContactForm client:visible lang={lang} email={person.email} />
  </div>
</section>
