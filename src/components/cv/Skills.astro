---
import { ui } from '../../data/ui';
import { softSkills, stack } from '../../data/cv';
import type { Lang } from '../../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

// Stack items may carry a translation as "es|en"
const label = (item: string) => {
  const [es, en] = item.split('|');
  return lang === 'en' && en ? en : es;
};
---

<section class="section sheet" id="skills" aria-labelledby="skills-title">
  <h2 class="section-title" id="skills-title">{t.skills}</h2>
  <div class="split">
    <div>
      <div class="side-block">
        <h3>{t.soft}</h3>
        <ul class="plain-list">
          {softSkills[lang].map((skill) => <li>{skill}</li>)}
        </ul>
      </div>
      <div class="side-block">
        <h3>{t.education}</h3>
        <p>{t.university}</p>
        <p class="muted">{t.degree}, 2014</p>
      </div>
    </div>
    <div>
      <h3 class="visually-hidden">{t.stack}</h3>
      <dl class="stack">
        {stack.map((group) => (
          <div>
            <dt>{group.label[lang]}</dt>
            <dd>{group.items.map(label).join(', ')}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
